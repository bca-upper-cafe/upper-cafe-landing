---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Upper Cafe • Bergen County Academies',
  description = 'Study hall check-in and daily teacher absence tracking for Bergen County Academies.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="bg-[#F8FAFC] text-[#0F172A] antialiased min-h-screen">
    <div class="max-w-4xl mx-auto px-4 py-8 md:py-12">
      <slot />
    </div>
  </body>
</html>
