---
import Layout from '../layouts/Layout.astro';

const currentYear = new Date().getFullYear();
const copyright = currentYear === 2026 ? '© 2026 Kabir Sekhon' : `© 2026-${currentYear} Kabir Sekhon`;
---

<Layout title="Upper Cafe • Bergen County Academies">

  <!-- Top nav bar -->
  <header class="flex items-center justify-between mb-12 pb-5 border-b border-slate-200">
    <div>
      <span class="text-base font-bold text-slate-900 tracking-tight">Upper Cafe</span>
      <span class="ml-2 px-1.5 py-0.5 text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-300 rounded align-middle">BCA</span>
    </div>
    <a
      href="http://app.bcaupper.cafe"
      class="text-xs font-semibold bg-slate-900 hover:bg-slate-700 text-white px-3.5 py-2 rounded-lg transition-colors"
    >
      Open Web App
    </a>
  </header>

  <!-- Hero -->
  <main class="space-y-12">
    <section class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-widest text-amber-700 mb-3">Bergen County Academies • Study Hall</p>
      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-slate-900 leading-tight">
        Check into Upper Cafe.<br />No clipboard. No paper.
      </h1>
      <p class="mt-4 text-slate-500 text-base leading-relaxed max-w-xl">
        Digital attendance for both scheduled study hall students and absent-teacher class coverage. Admins see a live roster and can pull the daily absence list straight from the BCA Google Doc.
      </p>
      <div class="mt-6 flex items-center gap-3">
        <a
          href="http://app.bcaupper.cafe"
          class="bg-slate-900 hover:bg-slate-700 text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors"
        >
          Student Check-In
        </a>
        <a
          href="http://app.bcaupper.cafe/absences"
          class="bg-white hover:bg-slate-50 text-slate-700 text-sm font-semibold px-5 py-2.5 rounded-lg border border-slate-200 transition-colors"
        >
          View Today's Absences
        </a>
      </div>
    </section>

    <!-- How it works: two columns, clean -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white border border-slate-200 rounded-xl p-6">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Scenario 1</div>
        <h2 class="text-lg font-bold text-slate-900 mb-2">Scheduled Study Hall</h2>
        <p class="text-sm text-slate-500 leading-relaxed">
          If Upper Cafe is on your Genesis schedule, walk in and check in. Select your period, enter your name and ID, and you're logged.
        </p>
      </div>
      <div class="bg-white border border-slate-200 rounded-xl p-6">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Scenario 2</div>
        <h2 class="text-lg font-bold text-slate-900 mb-2">Teacher is Absent</h2>
        <p class="text-sm text-slate-500 leading-relaxed">
          If your class teacher is absent, pick the period, select the teacher from the daily absence list, and check in. No hunting through Google Docs.
        </p>
      </div>
    </section>

    <!-- Platform cards -->
    <section class="space-y-3">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-400">Platform</h2>

      <a href="http://app.bcaupper.cafe" class="block bg-white border border-slate-200 rounded-xl p-5 hover:border-slate-400 transition-colors group">
        <div class="flex items-center justify-between">
          <div>
            <div class="text-sm font-bold text-slate-900">Web App — app.bcaupper.cafe</div>
            <div class="text-xs text-slate-500 mt-0.5">Student check-in/out and admin attendance desk with Google Doc import.</div>
          </div>
          <span class="text-slate-300 group-hover:text-slate-600 transition-colors text-lg">→</span>
        </div>
      </a>

      <div class="bg-white border border-slate-200 rounded-xl p-5">
        <div class="flex items-center justify-between">
          <div>
            <div class="text-sm font-bold text-slate-900">Mobile App — iOS & Android</div>
            <div class="text-xs text-slate-500 mt-0.5">View daily teacher absences by period from your phone. Check-in is done on laptops only.</div>
          </div>
          <span class="text-[10px] font-semibold text-slate-400 border border-slate-200 px-2 py-0.5 rounded">In Development</span>
        </div>
      </div>

      <a href="http://api.bcaupper.cafe" class="block bg-white border border-slate-200 rounded-xl p-5 hover:border-slate-400 transition-colors group">
        <div class="flex items-center justify-between">
          <div>
            <div class="text-sm font-bold text-slate-900">API — api.bcaupper.cafe</div>
            <div class="text-xs text-slate-500 mt-0.5">REST API for absences, check-ins, live roster stats, and Google Doc parsing.</div>
          </div>
          <span class="text-slate-300 group-hover:text-slate-600 transition-colors text-lg">→</span>
        </div>
      </a>
    </section>
  </main>

  <!-- Footer -->
  <footer class="mt-16 pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-400">
    <span>{copyright}</span>
    <span>Bergen County Academies • Hackensack, NJ</span>
  </footer>

</Layout>
