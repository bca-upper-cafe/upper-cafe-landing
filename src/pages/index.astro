---
const currentYear = new Date().getFullYear();
const yearDisplay = currentYear === 2026 ? "2026" : `2026 - ${currentYear}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>bcaupper.cafe</title>
    <style>
        :root {
            --bg: #ffffff;
            --text: #111111;
            --muted: #666666;
            --border: #eaeaea;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            font-size: 16px;
            line-height: 1.6;
            padding: 40px 20px;
            max-width: 580px;
            margin: 0 auto;
        }

        header {
            margin-bottom: 32px;
        }

        h1 {
            font-size: 1.25rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            margin-bottom: 8px;
        }

        p {
            color: var(--muted);
            margin-bottom: 24px;
            font-size: 0.95rem;
        }

        hr {
            border: none;
            border-top: 1px solid var(--border);
            margin: 28px 0;
        }

        .section-title {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--muted);
            margin-bottom: 12px;
            font-weight: 600;
        }

        ul {
            list-style: none;
            margin-bottom: 24px;
        }

        li {
            margin-bottom: 10px;
            font-size: 0.95rem;
        }

        a {
            color: var(--text);
            text-decoration: underline;
            text-underline-offset: 3px;
            text-decoration-color: #d1d1d1;
        }

        a:hover {
            text-decoration-color: var(--text);
        }

        .muted-text {
            color: var(--muted);
        }

        footer {
            margin-top: 40px;
            font-size: 0.85rem;
            color: var(--muted);
        }

        footer nav {
            margin-top: 12px;
            display: flex;
            gap: 12px;
        }

        footer nav a {
            color: var(--muted);
            font-size: 0.85rem;
        }
    </style>
</head>
<body>

    <header>
        <h1>bcaupper.cafe</h1>
        <p>the official platform for signing into <i>upper cafe</i> and checking teacher attendance at Bergen County Academies</p>
    </header>

    <main>
        <div class="section-title">Access Platforms</div>
        <ul>
            <li>
                <strong>Web App:</strong> <a href="https://app.bcaupper.cafe/">Open in browser &rarr;</a>
            </li>
            <li>
                <strong>iOS App:</strong> <a href="#AppStoreRedirect">Download on the App Store &rarr;</a>
            </li>
            <li>
                <strong>Android App:</strong> <a href="#PlayStoreRedirect">Download on the Play Store &rarr;</a>
            </li>
        </ul>

        <hr />

        <div class="section-title">About</div>
        <p>
            bcaupper.cafe replaces paper and a Google Docs and  with a direct system for <i>upper cafe</i> sign-ins and teacher attendence tracking
        </p>

        <ul style="margin-bottom: 0;">
            <li><a href="https://app.bcaupper.cafe/">Sign-in To Upper Cafe &rarr;</a></li>
        </ul>
    </main>

    <hr />

    <footer>
        <div>Built and maintained by Kabir Sekhon (ATCS '30).</div>
        <div>&copy; {yearDisplay} Kabir Sekhon. All rights reserved.</div>

        <nav>
            <a href="/terms">Terms of Service</a>
            <span>&middot;</span>
            <a href="/privacy">Privacy Policy</a>
            <span>&middot;</span>
            <a href="https://github.com/bca-upper-cafe/" target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
    </footer>

</body>
</html>
